<mujoco model="bouncing_balls">
  <asset>
    <!-- Gradient sky, as used by MuJoCo's own sample models. -->
    <texture type="skybox" builtin="gradient" rgb1=".3 .5 .7" rgb2="0 0 0" width="32" height="512"/>
    <!-- The checker board used by MuJoCo's own sample models. -->
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
    <material name="grid" texture="grid" texrepeat="1 1" texuniform="true" reflectance=".2"/>
  </asset>
  <worldbody>
    <!-- MuJoCo's sample scenes light their dark checker floor explicitly. -->
    <light name="sun" directional="true" dir="-.3 .3 -1" diffuse=".8 .8 .8" specular=".2 .2 .2"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="grid" condim="3"/>
    <!-- Five 25 cm balls, centres 0.75 m apart, dropped from z = 1 m.
         Second solref value is the contact damping ratio: lower bounces more,
         1 is critically damped (no bounce). With the default Euler integrator a
         ratio near 0 injects energy and the ball flies away, so the ramp starts
         at a moderate 0.2 (bouncy but stable) and rises to 1 (dead).
         priority makes each ball's contact parameters win over the floor. -->
    <body name="ball_red" pos="-1.5 0 1">
      <freejoint name="ball_red_free"/>
      <geom name="ball_red_geom" type="sphere" size="0.125" rgba="1 0 0 1"
            priority="1" solref="0.02 0.2"/>
    </body>
    <body name="ball_green" pos="-0.75 0 1">
      <freejoint name="ball_green_free"/>
      <geom name="ball_green_geom" type="sphere" size="0.125" rgba="0 1 0 1"
            priority="1" solref="0.02 0.4"/>
    </body>
    <body name="ball_blue" pos="0 0 1">
      <freejoint name="ball_blue_free"/>
      <geom name="ball_blue_geom" type="sphere" size="0.125" rgba="0 0 1 1"
            priority="1" solref="0.02 0.6"/>
    </body>
    <body name="ball_yellow" pos="0.75 0 1">
      <freejoint name="ball_yellow_free"/>
      <geom name="ball_yellow_geom" type="sphere" size="0.125" rgba="1 1 0 1"
            priority="1" solref="0.02 0.8"/>
    </body>
    <body name="ball_magenta" pos="1.5 0 1">
      <freejoint name="ball_magenta_free"/>
      <geom name="ball_magenta_geom" type="sphere" size="0.125" rgba="1 0 1 1"
            priority="1" solref="0.02 1"/>
    </body>
  </worldbody>
</mujoco>
